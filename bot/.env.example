# ---- DTM-R live bot configuration ----
# Copy to .env and fill in.  KEEP THIS FILE SECRET (chmod 600).

# Binance USDT-M Futures API key/secret.
# Create a FUTURES-ONLY key, disable withdrawals, restrict to your VPS IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# SAFETY SWITCHES — change deliberately.
# TESTNET=true  -> testnet.binancefuture.com (paper). false -> real exchange.
# DRY_RUN=true  -> compute & log signals/orders but place NOTHING.
TESTNET=true
DRY_RUN=true

# Strategy (defaults = the walk-forward-validated DTM-R config; change only
# if you re-tune and re-validate).
EMA_FAST=10
EMA_SLOW=34
TREND_EMA=100
ROC_MIN=0.05
ADX_MIN=22
CHAND_MULT=6
MARKET_MA=150

# Risk / portfolio.
RISK_FRAC=0.025          # fraction of equity risked to the stop, per trade
MAX_POSITIONS=6
LEVERAGE=2
MAX_LEVERAGE=2
ISOLATED_MARGIN=true

# Bot-level guardrails.
MAX_ACCOUNT_DRAWDOWN=0.35   # halt NEW entries once account is 35% below peak
MIN_FREE_BALANCE=1.0        # never deploy below this many USDT free
POLL_SECONDS=3600           # loop cadence (the strategy acts once per daily bar)

# Optional: comma-separated override of the traded universe.
# UNIVERSE=BTCUSDT,ETHUSDT,SOLUSDT
LOG_LEVEL=INFO
STATE_FILE=state.json
