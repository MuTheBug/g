# Copy to config.env (chmod 600).  Credentials may live here OR in /root/keys.txt
# (the bot reads /root/keys.txt first via KEYS_FILE). Keep secrets out of git.

# ---- Binance USDT-M futures API (optional here if set in /root/keys.txt) ----
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Start on TESTNET (https://testnet.binancefuture.com keys) until you trust it.
BINANCE_TESTNET=false
# DRY_RUN logs every intended order but places NONE. Keep true for the first run.
DRY_RUN=true

# ---- Telegram (optional here if set in /root/keys.txt) ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---- strategy (defaults = the backtested v3 headline; usually leave as-is) ----
LEVERAGE=1.0               # multiplier on the 40% vol target (2.0 = aggressive)
DAILY_LOSS_LIMIT=8         # daily-loss kill-switch in $ (0 disables)
MAX_GROSS=3.0             # cap on total notional / equity
# LOOKBACKS=15,30,60,90    # trend lookback days
# K_STRENGTH=2.0           # tanh steepness of risk-adjusted trend
# SELECT_TOP=6             # select top-6 by conviction...
# HOLD_TOP=10              # ...then hold top-10 of the EMA-smoothed book
# EMA_SPANS=5,10,15        # weight-smoothing ensemble
# TARGET_VOL=0.40          # base annualized vol target
# SL_PCT=0.18              # protective stop per position
# TP_PCT=0.50              # take-profit per position
# SYMBOL_LEVERAGE=10       # per-symbol Binance leverage (margin headroom)
# UNIVERSE_TOP_N=80        # selectable universe by 24h volume
# REBALANCE_HOUR_UTC=0     # rebalance once per UTC day after this hour
# POLL_SECONDS=120
