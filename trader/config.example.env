# ---- Binance USDT-M futures API (create at binance.com -> API Management) ----
# The key needs Futures trading permission. Whitelist your VPS IP for safety.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Start on TESTNET (https://testnet.binancefuture.com keys) until you trust it.
BINANCE_TESTNET=true
# DRY_RUN logs every order but places NONE. Great for a first run.
DRY_RUN=true

# ---- Telegram alerts (talk to @BotFather to make a bot, @userinfobot for id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- strategy (defaults = the backtested headline config; usually leave as-is)
MARGIN_PER_LEG=10        # $ isolated margin per leg
LEVERAGE=5               # -> $50 notional per leg
LOOKBACK_DAYS=20         # cross-sectional momentum window
K_PER_SIDE=1             # 1 long + 1 short per basket
MAX_BASKETS=2            # max concurrent baskets (fixed ~$60 account)
TP_USD=3                 # close the WHOLE basket at +$3 combined
SL_USD=5                 # basket stop
LEG_STOP_FRAC=0.12       # 12% protective stop per leg (rests on Binance)
MAX_HOLD_DAYS=20         # force-close a basket after this many days
UNIVERSE_TOP_N=100       # rank the top-N crypto perps by 24h volume
POLL_SECONDS=300         # how often to check basket take-profit
